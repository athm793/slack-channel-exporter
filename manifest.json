{
  "manifest_version": 3,
  "name": "Slack Channel Exporter",
  "version": "2.0.0",
  "description": "Auto-export Slack channels every 6 hours. Paste channel URLs and let it run.",
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://*.slack.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://*.slack.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected/page-script.js"],
      "matches": ["https://*.slack.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
